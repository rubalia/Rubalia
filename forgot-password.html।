<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#071a35">
<title>Forgot Password - RUBALIA NETWORK</title>

<style>
:root{
  --navy:#071a35;
  --navy2:#102b50;
  --gold:#d6ad55;
  --white:#ffffff;
  --light:#f4f6fa;
  --text:#26354a;
  --muted:#758195;
  --border:#e0e5ed;
}
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial,Helvetica,sans-serif;
  background:var(--light);
  color:var(--text);
  min-height:100vh;
  display:flex;
  flex-direction:column;
}
header{
  background:var(--navy);
  padding:17px 20px;
  color:white;
}
.nav{
  max-width:1100px;
  margin:auto;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px;
}
.logo{
  font-size:21px;
  font-weight:800;
  color:white;
  text-decoration:none;
  letter-spacing:1px;
}
.logo span{color:var(--gold)}
.nav a:not(.logo){
  color:white;
  text-decoration:none;
  font-size:14px;
  margin-left:16px;
}
.nav a:hover{color:var(--gold)}
main{
  flex:1;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:45px 15px;
}
.recovery-card{
  width:100%;
  max-width:460px;
  background:white;
  border-radius:16px;
  padding:35px 30px;
  box-shadow:0 8px 35px rgba(7,26,53,.08);
}
.icon-circle{
  width:68px;
  height:68px;
  margin:0 auto 20px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:50%;
  background:#f8f1df;
  color:#9a762e;
  font-size:30px;
}
.heading{text-align:center}
.heading h1{
  color:var(--navy);
  font-size:26px;
  margin:0 0 12px;
}
.heading p{
  color:var(--muted);
  font-size:14px;
  line-height:1.7;
  margin:0 0 28px;
}
.form-group{margin-bottom:20px}
label{
  display:block;
  font-size:13px;
  font-weight:700;
  margin-bottom:8px;
  color:var(--navy);
}
input{
  width:100%;
  height:48px;
  border:1px solid var(--border);
  border-radius:8px;
  padding:0 13px;
  font-size:14px;
  outline:none;
}
input:focus{
  border-color:var(--gold);
  box-shadow:0 0 0 3px rgba(214,173,85,.13);
}
input::placeholder{color:#a4adba}
.submit-btn{
  width:100%;
  height:49px;
  border:0;
  border-radius:8px;
  background:var(--gold);
  color:var(--navy);
  font-size:14px;
  font-weight:800;
  cursor:pointer;
  transition:.2s;
}
.submit-btn:hover{
  background:#c69a3e;
  transform:translateY(-1px);
}
.back-link{
  text-align:center;
  margin-top:23px;
  font-size:13px;
}
.back-link a{
  color:var(--navy);
  text-decoration:none;
  font-weight:bold;
}
.demo-notice{
  margin-top:25px;
  padding:13px;
  background:#fff8e8;
  border:1px solid #f0dfb7;
  border-radius:8px;
  color:#806329;
  font-size:12px;
  line-height:1.6;
}
footer{
  background:var(--navy);
  color:#c6cfdd;
  text-align:center;
  padding:22px 15px;
  font-size:12px;
}
footer span{color:var(--gold)}
@media(max-width:500px){
  .nav{flex-wrap:wrap}
  .recovery-card{padding:28px 20px}
  main{padding:30px 15px}
}
</style>
</head>

<body>

<header>
  <div class="nav">
    <a class="logo" href="index.html">RUBALIA <span>NETWORK</span></a>
    <div>
      <a href="index.html">Home</a>
      <a href="login.html">Login</a>
    </div>
  </div>
</header>

<main>
  <section class="recovery-card">

    <div class="icon-circle">🔐</div>

    <div class="heading">
      <h1>Forgot Password?</h1>
      <p>
        Don't worry. Enter the email address associated with your
        member account to request a password reset.
      </p>
    </div>

    <form id="recoveryForm">

      <div class="form-group">
        <label for="email">Registered Email Address</label>
        <input
          type="email"
          id="email"
          placeholder="Enter your registered email"
          autocomplete="email"
          required
        >
      </div>

      <button type="submit" class="submit-btn">
        REQUEST PASSWORD RESET
      </button>

    </form>

    <div class="back-link">
      Remember your password?
      <a href="login.html">Back to Login</a>
    </div>

    <div class="demo-notice">
      <strong>Demo Notice:</strong> Password recovery is not activated
      yet. This form does not send emails or change account passwords.
      A secure backend and email verification system will be required.
    </div>

  </section>
</main>

<footer>
  © <span>RUBALIA NETWORK</span> — All Rights Reserved.
</footer>

<script>
document.getElementById("recoveryForm").addEventListener("submit",function(e){
  e.preventDefault();

  const email=document.getElementById("email").value.trim();

  if(!email){
    alert("Please enter your registered email address.");
    return;
  }

  alert(
    "Password recovery is not activated yet.\n\n" +
    "This is a frontend demo. No email has been sent."
  );
});
</script>

</body>
</html>
